[Unit]
Description=Sync read-only Yunxiao facts into Shepherd
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Shepherd/plugins/yunxiao/scripts
EnvironmentFile=%h/.config/shepherd-yunxiao/env
ExecStart=/usr/bin/python3 %h/Shepherd/plugins/yunxiao/scripts/yunxiao_sync.py
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/shepherd-yunxiao
UMask=0077
