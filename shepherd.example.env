# Shepherd 配置示例 —— 复制为 shepherd.env(共享默认)或 shepherd.<profile>.env(按环境)。
#
# 加载顺序(前者优先):进程环境 > shepherd.${SHEPHERD_ENV}.env > shepherd.env
# 文件目录由 SHEPHERD_CONFIG_DIR 指定(缺省为当前目录)。进程环境始终胜出。
#
# 例:SHEPHERD_ENV=prod ./server  → 读 shepherd.prod.env 覆盖 shepherd.env,
#     再被任何已导出的环境变量覆盖。

DATABASE_URL=postgres://user:pass@localhost:5432/shepherd
SHEPHERD_BIND=0.0.0.0:8088
SHEPHERD_ADMIN_PASSWORD=change-me
SHEPHERD_SESSION_TTL_SECS=28800

# 跨域允许列表(逗号分隔);不设则同源。
# SHEPHERD_CORS_ORIGINS=https://app.example.com

# 每客户端限流(opt-in,>0 才启用);BURST 缺省为 RPS*2。
# 限流默认 200 rps/客户端;设 0 关闭
# SHEPHERD_RATE_LIMIT_RPS=200
# SHEPHERD_RATE_LIMIT_BURST=40

# LLM 接线:openai(兼容)| anthropic(原生 Messages API)。
# SHEPHERD_LLM_WIRE=anthropic

# OIDC(飞书 / 企业微信):APP_ID + SECRET 同时存在才启用。
# SHEPHERD_FEISHU_APP_ID=
# SHEPHERD_FEISHU_APP_SECRET=
# SHEPHERD_FEISHU_REDIRECT=

# LDAP 目录认证(本地授权 + 外部认证):本地口令不符时回退绑定。
# 两个变量配齐才启用;DN 模板必须含 {username}。用户须已在本地存在(不自动开户)。
# SHEPHERD_LDAP_URL=ldaps://dir.example.com:636
# SHEPHERD_LDAP_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

# 机群派发(见 docs);不设则单机进程内队列 + Echo 桩执行者。
# SHEPHERD_AGENT_FLEET=1
# SHEPHERD_FLEET_REDIS=redis://localhost:6379
