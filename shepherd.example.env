# Copy to shepherd.env for shared defaults or shepherd.<profile>.env for overrides.
#
# Precedence: process environment > shepherd.${SHEPHERD_ENV}.env > shepherd.env.
# SHEPHERD_CONFIG_DIR selects the config directory; default: current directory.
#
# Example: SHEPHERD_ENV=prod ./server loads shepherd.prod.env over shepherd.env.
# Exported environment variables take precedence.

DATABASE_URL=postgres://user:pass@localhost:5432/shepherd
SHEPHERD_BIND=0.0.0.0:8088
SHEPHERD_ADMIN_PASSWORD=change-me
SHEPHERD_SESSION_TTL_SECS=28800

# Comma-separated CORS allowlist; unset for same-origin requests.
# SHEPHERD_CORS_ORIGINS=https://app.example.com

# Per-client rate limit; BURST defaults to RPS * 2.
# Default: 200 requests per second per client; 0 disables limiting.
# SHEPHERD_RATE_LIMIT_RPS=200
# SHEPHERD_RATE_LIMIT_BURST=40

# LLM provider: openai-compatible or native Anthropic Messages API.
# SHEPHERD_LLM_WIRE=anthropic

# OIDC requires both APP_ID and SECRET.
# SHEPHERD_FEISHU_APP_ID=
# SHEPHERD_FEISHU_APP_SECRET=
# SHEPHERD_FEISHU_REDIRECT=

# Fall back to LDAP binding when the local password does not match.
# Both variables are required; the DN template must contain {username}. Users must exist locally.
# SHEPHERD_LDAP_URL=ldaps://dir.example.com:636
# SHEPHERD_LDAP_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com

# Fleet dispatch; unset to use the in-process queue and Echo executor.
# SHEPHERD_AGENT_FLEET=1
# SHEPHERD_FLEET_REDIS=redis://localhost:6379

# Optional integrations, comma-separated. Restart the Shepherd server after changes.
# SHEPHERD_PLUGINS=yunxiao
SHEPHERD_PLUGINS=
# Required only when the Yunxiao plugin is enabled; use a separate database and account.
SHEPHERD_YUNXIAO_DATABASE_URL=

# Environment capability plugin (SHEPHERD_PLUGINS=environment, or yunxiao,environment).
# Use a database with a different name from the host database.
SHEPHERD_ENVIRONMENT_PLUGINS_DATABASE_URL=
# JSON map of key IDs to base64-encoded 32-byte encryption keys. Never commit real keys.
SHEPHERD_ENVIRONMENT_PLUGIN_KEYS=
SHEPHERD_ENVIRONMENT_PLUGIN_ACTIVE_KEY=v1
