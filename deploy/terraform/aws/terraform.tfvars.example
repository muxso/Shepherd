# Copy to terraform.tfvars and fill in.

region      = "us-east-1"
name_prefix = "shepherd"

kubernetes_version  = "1.30"
node_instance_types = ["t3.large"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 6

# Database
db_name              = "shepherd"
db_username          = "shepherd"
db_password          = "" # leave empty to auto-generate a random password
db_instance_class    = "db.t3.medium"
db_allocated_storage = 20

# Redis
redis_node_type = "cache.t3.micro"

# Shepherd app
admin_password  = "change-me-in-prod"
agent_key       = "" # sak_… — issue via POST /system/apikey after first boot, then re-apply
image_tag       = "latest"
server_host     = "shepherd.example.com"
web_host        = "shepherd.example.com"
server_replicas = 2
agent_replicas  = 3
