#!/bin/sh
# Local pre-commit guardrail for the Shepherd workspace.
# Enforces the same formatting + lint gate as CI (.github/workflows/ci.yml)
# so commits can never skip `cargo fmt` / `cargo clippy` again.
#
# Activated with: git config core.hooksPath .githooks
set -e

echo "[pre-commit] cargo fmt --all --check"
cargo fmt --all --check

echo "[pre-commit] cargo clippy --workspace --locked -- -D warnings"
cargo clippy --workspace --locked -- -D warnings

echo "[pre-commit] ok"
